{
  "C:\\Users\\vicky\\Node\\serverless.yml": {
    "versionFramework": "4.14.1",
    "servicePath": "C:\\Users\\vicky\\Node\\serverless.yml",
    "serviceConfigFileName": "serverless.yml",
    "service": {
      "service": "miranda-backend",
      "frameworkVersion": "3",
      "package": {
        "patterns": [
          "!./**",
          "package.json",
          "node_modules/**",
          "dist/**",
          "data/**",
          "public/**"
        ]
      },
      "provider": {
        "name": "aws",
        "region": "eu-west-3",
        "runtime": "nodejs18.x"
      },
      "functions": {
        "app": {
          "handler": "dist/lambda.handler",
          "events": [
            {
              "http": {
                "path": "/",
                "method": "ANY",
                "cors": true
              }
            },
            {
              "http": {
                "path": "/{proxy+}",
                "method": "ANY",
                "cors": true
              }
            }
          ]
        }
      }
    },
    "provider": {
      "name": "aws",
      "region": "eu-west-3",
      "runtime": "nodejs18.x"
    },
    "serviceRawFile": "service: miranda-backend\r\nframeworkVersion: \"3\"\r\npackage:\r\n  patterns:\r\n    - \"!./**\"\r\n    - \"package.json\"\r\n    - \"node_modules/**\"\r\n    - \"dist/**\"\r\n    - \"data/**\"\r\n    - \"public/**\"\r\nprovider:\r\n  name: aws\r\n  region: eu-west-3\r\n  runtime: nodejs18.x\r\nfunctions:\r\n  app:\r\n    handler: dist/lambda.handler\r\n    events:\r\n      - http:\r\n          path: /\r\n          method: ANY\r\n          cors: true\r\n      - http:\r\n          path: /{proxy+}\r\n          method: ANY\r\n          cors: true",
    "command": [],
